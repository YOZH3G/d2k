  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default outlined pill control (restart).",
      "html": "<button class=\"ds-btn\">Перезапустить</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;font:600 14px/1 var(--sans,'Onest',system-ui,sans-serif);color:var(--ink,#17160f);background:transparent;border:1px solid var(--rule-strong,#17160f);border-radius:999px;cursor:pointer;transition:background-color .16s,color .16s,border-color .16s,transform .16s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:var(--paper-2,#eae5d8)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--focus,#1f48d6);outline-offset:3px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-filled pill for the main positive action.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Запустить</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;font:600 14px/1 var(--sans,'Onest',system-ui,sans-serif);color:var(--ink,#17160f);background:transparent;border:1px solid var(--rule-strong,#17160f);border-radius:999px;cursor:pointer;transition:background-color .16s,color .16s,border-color .16s,transform .16s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:var(--paper-2,#eae5d8)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--focus,#1f48d6);outline-offset:3px}.ds-btn-primary{background:var(--ink,#17160f);color:var(--paper,#f6f3eb)}.ds-btn-primary:hover{background:color-mix(in srgb,var(--ink,#17160f) 86%,var(--signal,#e8470f))}"
    },
    {
      "name": "Stop: danger then confirm",
      "kind": "button",
      "refersTo": "button-confirm",
      "description": "Red outline stop; the second press is a solid red confirm with a ghost cancel, inline, no modal.",
      "html": "<button class=\"ds-btn ds-btn-danger\">Остановить</button> <button class=\"ds-btn ds-btn-confirm\">Остановить движок?</button> <button class=\"ds-btn ds-btn-ghost\">Отмена</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;font:600 14px/1 var(--sans,'Onest',system-ui,sans-serif);color:var(--ink,#17160f);background:transparent;border:1px solid var(--rule-strong,#17160f);border-radius:999px;cursor:pointer;transition:background-color .16s,color .16s,border-color .16s,transform .16s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:var(--paper-2,#eae5d8)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--focus,#1f48d6);outline-offset:3px}.ds-btn-danger{color:var(--bad,#b02a17);border-color:var(--bad,#b02a17)}.ds-btn-danger:hover{background:var(--bad-wash,#f3d3cb)}.ds-btn-confirm{background:var(--bad,#b02a17);border-color:var(--bad,#b02a17);color:#fff}.ds-btn-ghost{border-color:var(--rule,#cdc6b5)}"
    },
    {
      "name": "Tags",
      "kind": "chip",
      "refersTo": "tag-live",
      "description": "Pill tags; wash background per tone.",
      "html": "<span class=\"ds-tag\" data-tone=\"live\">перепроверяется</span> <span class=\"ds-tag\" data-tone=\"ok\">применён</span> <span class=\"ds-tag\" data-tone=\"bad\">ошибка</span> <span class=\"ds-tag\">TLS</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;min-height:24px;padding:2px 9px;border-radius:999px;border:1px solid var(--rule,#cdc6b5);font:600 12.5px/1.3 var(--sans,'Onest',sans-serif);color:var(--ink,#17160f)}.ds-tag[data-tone=live]{background:var(--signal-wash,#f8d9c9);color:var(--signal-ink,#b8360a);border-color:transparent}.ds-tag[data-tone=ok]{background:var(--ok-wash,#d5e6d6);color:var(--ok,#1d6b47);border-color:transparent}.ds-tag[data-tone=bad]{background:var(--bad-wash,#f3d3cb);color:var(--bad,#b02a17);border-color:transparent}"
    },
    {
      "name": "Filter field",
      "kind": "input",
      "refersTo": "filter-field",
      "description": "Pill search across families and boxes.",
      "html": "<label class=\"ds-filter\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m15.5 15.5 5 5\"/></svg><input type=\"search\" placeholder=\"Найти домен или адрес\"></label>",
      "css": ".ds-filter{display:flex;align-items:center;gap:10px;max-width:560px;min-height:48px;padding:0 16px;border:1px solid var(--rule-strong,#17160f);border-radius:999px;background:var(--paper,#f6f3eb)}.ds-filter:focus-within{outline:2px solid var(--focus,#1f48d6);outline-offset:2px}.ds-filter svg{width:18px;height:18px;fill:none;stroke:var(--ink-2,#57534a);stroke-width:2;stroke-linecap:round}.ds-filter input{flex:1;border:0;outline:0;background:transparent;font:400 15px var(--sans,'Onest',sans-serif);color:var(--ink,#17160f);caret-color:var(--signal,#e8470f)}"
    },
    {
      "name": "Section index",
      "kind": "nav",
      "refersTo": "",
      "description": "Sticky ruled index with counts; current section marked by a signal dot.",
      "html": "<nav class=\"ds-index\"><a href=\"#\" aria-current=\"true\"><span>Сейчас</span><b data-tone=\"live\">2</b></a><a href=\"#\"><span>Семейства</span><b>4</b></a><a href=\"#\"><span>Коробки</span><b>3</b></a></nav>",
      "css": ".ds-index{display:flex;flex-direction:column;width:220px}.ds-index a{display:flex;justify-content:space-between;padding:9px 0;text-decoration:none;color:var(--ink-2,#57534a);font:500 15px var(--sans,'Onest',sans-serif);border-bottom:1px solid var(--rule,#cdc6b5);transition:color .16s}.ds-index a:hover{color:var(--ink,#17160f)}.ds-index a[aria-current=true]{color:var(--ink,#17160f);font-weight:650}.ds-index a[aria-current=true] span::before{content:'';display:inline-block;width:6px;height:6px;margin:0 8px 2px 0;background:var(--signal,#e8470f);border-radius:50%}.ds-index b{font-weight:500;font-size:13px;color:var(--ink-3,#6f6a5f)}.ds-index b[data-tone=live]{color:var(--signal-ink,#b8360a);font-weight:650}"
    },
    {
      "name": "Search row with phase track",
      "kind": "custom",
      "refersTo": "",
      "description": "Live search: target, phase sentence and a track mirroring the original's phases.",
      "html": "<div class=\"ds-search\"><div class=\"ds-target\">example.org</div><div class=\"ds-phase\">выводим планы</div><div class=\"ds-track\" style=\"--steps:7;--at:4\"><i class=\"ds-fill\"></i><span data-state=\"past\">Очередь</span><span data-state=\"past\">Форма</span><span data-state=\"past\">Распознаём</span><span data-state=\"past\">Свойства</span><span data-state=\"now\">Планы</span><span>Проверка</span><span>Подтверждено</span></div></div>",
      "css": ".ds-search{padding:26px 0 24px;border-bottom:1px solid var(--rule,#cdc6b5);font-family:var(--sans,'Onest',sans-serif);animation:ds-arrive .5s cubic-bezier(.16,1,.3,1)}@keyframes ds-arrive{from{opacity:0;transform:translateY(8px)}}.ds-target{font-size:30px;font-weight:700;letter-spacing:-.02em;line-height:1.12}.ds-phase{margin-top:14px;font-weight:550}.ds-phase::before{content:'';display:inline-block;width:8px;height:8px;margin-right:10px;border-radius:50%;background:var(--signal,#e8470f)}.ds-track{position:relative;display:grid;grid-template-columns:repeat(var(--steps),minmax(0,1fr));margin-top:12px}.ds-track::before{content:'';position:absolute;left:0;right:0;top:5px;height:1px;background:var(--rule,#cdc6b5)}.ds-fill{position:absolute;left:0;top:4px;height:3px;width:100%;border-radius:2px;background:var(--signal,#e8470f);transform-origin:left;transform:scaleX(calc(var(--at)/var(--steps)));transition:transform .7s cubic-bezier(.16,1,.3,1)}.ds-track span{position:relative;padding-top:20px;font-size:12.5px;color:var(--ink-3,#6f6a5f)}.ds-track span::before{content:'';position:absolute;left:0;top:1px;width:9px;height:9px;border-radius:50%;background:var(--paper,#f6f3eb);border:1.5px solid var(--rule,#cdc6b5)}.ds-track span[data-state=past]::before{background:var(--ink-3,#6f6a5f);border-color:var(--ink-3,#6f6a5f)}.ds-track span[data-state=now]{color:var(--ink,#17160f);font-weight:650}.ds-track span[data-state=now]::before{background:var(--signal,#e8470f);border-color:var(--signal,#e8470f);box-shadow:0 0 0 4px var(--signal-wash,#f8d9c9)}@media (prefers-reduced-motion:reduce){.ds-search,.ds-fill{animation:none;transition:none}}"
    },
    {
      "name": "Family card",
      "kind": "card",
      "refersTo": "family-card-applied",
      "description": "Paper-2 card; an applied family inverts to ink.",
      "html": "<article class=\"ds-family\"><h3>*.example<span>.org</span></h3><span class=\"ds-tag-ok\">применён</span><ul><li>a.example.org</li><li>b.example.org</li></ul></article>",
      "css": ".ds-family{display:flex;flex-direction:column;gap:14px;width:300px;padding:22px 22px 20px;border-radius:14px;background:var(--ink,#17160f);color:var(--paper,#f6f3eb);font-family:var(--sans,'Onest',sans-serif)}.ds-family h3{margin:0;font-size:26px;font-weight:720;letter-spacing:-.025em}.ds-family h3 span{opacity:.45;font-weight:500}.ds-tag-ok{align-self:flex-start;padding:2px 9px;border-radius:999px;background:var(--ok-bright,#8fdcb2);color:#0f2a1c;font:600 12.5px/1.3 inherit}.ds-family ul{margin:0;padding:0;list-style:none;font-size:14px;color:color-mix(in srgb,var(--paper,#f6f3eb) 72%,var(--ink,#17160f))}"
    },
    {
      "name": "Engine lamp",
      "kind": "custom",
      "refersTo": "",
      "description": "Status lamp; the live tone pulses.",
      "html": "<span class=\"ds-lamp\" data-tone=\"live\"></span> <span class=\"ds-lamp\" data-tone=\"ok\"></span> <span class=\"ds-lamp\" data-tone=\"bad\"></span>",
      "css": ".ds-lamp{position:relative;display:inline-block;width:10px;height:10px;margin:8px;border-radius:50%;background:var(--ink-3,#6f6a5f)}.ds-lamp[data-tone=ok]{background:var(--ok,#1d6b47)}.ds-lamp[data-tone=bad]{background:var(--bad,#b02a17)}.ds-lamp[data-tone=live]{background:var(--signal,#e8470f)}.ds-lamp[data-tone=live]::after{content:'';position:absolute;inset:-5px;border-radius:50%;border:1.5px solid var(--signal,#e8470f);animation:ds-lamp 1.8s cubic-bezier(.16,1,.3,1) infinite}@keyframes ds-lamp{from{transform:scale(.5);opacity:1}to{transform:scale(1.6);opacity:0}}@media (prefers-reduced-motion:reduce){.ds-lamp::after{animation:none}}"
    }
  ],
  "narrative": {
    "northStar": "Ведомость",
    "overview": "The panel is a printed ledger: warm paper, near-black ink, hairline rules, and Swiss editorial type in Onest. It reads top to bottom as one sheet: the masthead states what the engine is doing, «Сейчас» says it again as a big headline, then the catalogue (families, boxes), the Telegram tunnel and diagnostics follow as ruled sections. Density is that of a well-set report: generous section spacing, tight tabular rows inside.\n\nColour is information, not decoration. One orange signal belongs to live search activity; green means confirmed or applied; red means stop or failure. Everything else is paper and ink in two themes (light and dark), switched by `prefers-color-scheme` on `:root` tokens. Fonts are self-hosted (Onest, JetBrains Mono, OFL) and the panel works fully offline on the router.",
    "keyCharacteristics": [
      "Warm paper ground, ink text, 1px rules as the main structure.",
      "Onest for all language; JetBrains Mono only for machine data.",
      "One signal colour, reserved for the live search.",
      "Flat: depth comes from tone (paper / paper-2 / ink), never from shadows.",
      "Motion only where something actually progresses."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Orange means \"a search is running right now\". If nothing is being searched, no orange is on screen except the mark.",
        "section": "colors"
      },
      {
        "name": "The Earned Green Rule",
        "body": "Green appears only for a measured confirmation or an applied plan. Installed is not done; never green a state the engine has not confirmed.",
        "section": "colors"
      },
      {
        "name": "The Mono Is Data Rule",
        "body": "JetBrains Mono marks a value the user might copy or compare (plan, address, path, id). Labels, numbers in prose and headings stay in Onest.",
        "section": "typography"
      },
      {
        "name": "The Ruled Ledger Rule",
        "body": "Separate with 1px rules and tone, not shadows or boxes. Most content is rows on the page, not cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep orange for live search activity: lamp, slots, phase track, live tags.",
      "**Do** use green only for confirmed or applied states, red for stop and failure, amber for stale and exceptions.",
      "**Do** set machine data (plans, IPs, paths, ids) in JetBrains Mono and everything else in Onest.",
      "**Do** separate content with 1px rules and paper tones; reserve the inverted ink card for applied families.",
      "**Do** define every colour as a `:root` token with a dark-theme counterpart.",
      "**Do** keep two-step stop inline: danger outline, then solid red confirm with a ghost cancel.",
      "**Do** honour `prefers-reduced-motion` for every new animation."
    ],
    "donts": [
      "**Don't** use the signal colour for faults, warnings, connecting services or decoration.",
      "**Don't** add shadows, modals or a second accent colour.",
      "**Don't** load fonts or assets from the network; the panel must work offline.",
      "**Don't** put labels, headings or prose in the monospace face.",
      "**Don't** add uppercase letter-spaced kickers above section titles; the sheet head is title plus explanation."
    ]
  }
