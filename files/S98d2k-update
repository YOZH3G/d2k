#!/bin/sh
# Stable recovery precedes S99. D2K stop never terminates this independent path.
ROOT=${D2K_DIR:-/opt/d2k}
BOOT=$ROOT/boot/d2k-update-boot
case "${1:-start}" in
    start|restart)
        [ -x "$BOOT" ] || exit 0
        "$BOOT" --root "$ROOT" --recover || exit 1
        # Stable boot validates signed current or the sealed first-worker anchor.
        if [ -x "$ROOT/current/d2k-update" ] || [ -x "$ROOT/boot/d2k-update-first" ]; then
            mkdir -p "$ROOT/run" || exit 1
            start-stop-daemon -S -b -m -p "$ROOT/run/d2k-update-boot.pid" -x "$BOOT" -- --root "$ROOT" --daemon || exit 1
        else
            echo 'd2k-update: daemon not installed; recovery remains available' >&2
        fi
        ;;
    stop) : ;; # normal D2K service stop must not kill recovery
    *) exit 2 ;;
esac
